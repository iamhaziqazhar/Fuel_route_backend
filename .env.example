# =============================================================================
# Django core
# =============================================================================
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Third-party API keys
# =============================================================================

# Map / routing API (e.g. OpenRouteService, Mapbox Directions, Google Directions)
MAP_ROUTING_API_KEY=
MAP_ROUTING_API_BASE_URL=https://api.openrouteservice.org

# Geocoding API (e.g. OpenCage, Mapbox Geocoding, Google Geocoding)
GEOCODING_API_KEY=
GEOCODING_API_BASE_URL=https://api.opencagedata.com/geocode/v1

# Fuel price API (e.g. CollectAPI, EIA, GasBuddy)
FUEL_PRICE_API_KEY=
FUEL_PRICE_API_BASE_URL=https://api.collectapi.com/gasPrice
